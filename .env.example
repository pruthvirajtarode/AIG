# ==================================================
# AIGMS — Al Ihsan Group Qurban Management System
# Environment Variables
# Copy to .env.local for development
# NEVER commit real credentials to git
# ==================================================

# ──────────────────────────────────────────────────
# 1. BROWSER-SAFE FRONTEND VARIABLES (VITE_*)
#    WARNING: Any variable prefixed with VITE_ is bundled into browser JS.
#    NEVER place Meta Access Tokens, App Secrets, Service Role Keys,
#    or Cloudflare R2 Secret Keys in VITE_* variables!
# ──────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

VITE_APP_NAME="Al Ihsan Group — Qurban Management System"
VITE_APP_URL=https://www.aigsuite.com
VITE_APP_ENV=development

# Official WhatsApp Business display number (public non-secret identifier)
VITE_WHATSAPP_BUSINESS_NUMBER=+6585456783

# Set to true ONLY after deploying the `whatsapp-send` & `whatsapp-webhook`
# Supabase Edge Functions and configuring server-side Meta secrets below
VITE_ENABLE_LIVE_NOTIFICATIONS=false

# Set to true ONLY after deploying the `media-upload-url` Edge Function
# and configuring Cloudflare R2 server secrets below
VITE_ENABLE_LIVE_R2_STORAGE=false
VITE_R2_PUBLIC_URL=https://media.aigsuite.com

# ──────────────────────────────────────────────────
# 2. SERVER-ONLY SUPABASE EDGE FUNCTION SECRETS
#    Set via `supabase secrets set KEY=VALUE` (never prefixed with VITE_)
# ──────────────────────────────────────────────────
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
#
# # Meta WhatsApp Cloud API (+65 8545 6783) — Server-Only
# WHATSAPP_ACCESS_TOKEN=your-system-user-permanent-token
# WHATSAPP_PHONE_NUMBER_ID=your-meta-phone-number-id
# WHATSAPP_BUSINESS_ACCOUNT_ID=your-meta-waba-id
# WHATSAPP_APP_SECRET=your-meta-app-secret-for-webhook-hmac
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-random-webhook-verify-token
# WHATSAPP_GRAPH_API_VERSION=v21.0
#
# # Email Provider (One-Time Invoice + WhatsApp Fallback) — Server-Only
# RESEND_API_KEY=re_your_api_key_here
# NOTIFICATION_EMAIL_FROM="Al Ihsan Group <noreply@alihsangroup.sg>"
#
# # Cloudflare R2 Media Storage — Server-Only
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# R2_BUCKET_NAME=aigms-media
