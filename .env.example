# ==================================================
# AIGMS — Al Ihsan Group Qurban Management System
# Environment Variables
# Copy to .env.local for development
# NEVER commit real credentials to git
# ==================================================

# ── Supabase ──────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Service role key — SERVER SIDE ONLY (never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Application ───────────────────────────────────
VITE_APP_URL=http://localhost:3000
VITE_APP_ENV=development

# ── Cloudflare R2 (Media Storage) ─────────────────
# These are SERVER-SIDE ONLY — use a backend function/edge function
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=aigms-media
R2_PUBLIC_URL=https://your-r2-public-url.r2.dev

# ── Payment Gateway ───────────────────────────────
# Server-side only
PAYMENT_PROVIDER=mock
PAYMENT_PROVIDER_KEY=your-payment-key
PAYMENT_PROVIDER_SECRET=your-payment-secret
PAYMENT_WEBHOOK_SECRET=your-webhook-secret

# ── Email Provider ────────────────────────────────
# Server-side only
EMAIL_PROVIDER=mock
EMAIL_PROVIDER_KEY=your-email-key
EMAIL_FROM_ADDRESS=noreply@alhisangroup.com
EMAIL_FROM_NAME=Al Ihsan Group

# ── WhatsApp Provider ─────────────────────────────
# Server-side only
WHATSAPP_PROVIDER=mock
WHATSAPP_PROVIDER_KEY=your-whatsapp-key
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id

# ── SMS Provider ──────────────────────────────────
# Server-side only
SMS_PROVIDER=mock
SMS_PROVIDER_KEY=your-sms-key

# ── QR / Tracking ────────────────────────────────
VITE_TRACKING_BASE_URL=https://track.alhisangroup.com
